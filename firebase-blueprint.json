{
  "entities": {
    "CoupleConfig": {
      "title": "CoupleConfig",
      "description": "Configuration and profiles of the couple (names, colors, anniversary date, theme)",
      "type": "object",
      "properties": {
        "partner1": {
          "type": "object",
          "description": "Miguel's profile info"
        },
        "partner2": {
          "type": "object",
          "description": "Giulia's profile info"
        },
        "sharedColor": {
          "type": "string",
          "description": "Color for joint events"
        },
        "anniversaryDate": {
          "type": "string",
          "description": "Anniversary date (YYYY-MM-DD)"
        },
        "theme": {
          "type": "string",
          "description": "Active UI theme (classic, bears, dragons)"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["partner1", "partner2", "sharedColor", "theme"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Shared calendar event for the couple with support messages and memories",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique event ID"
        },
        "title": {
          "type": "string",
          "description": "Event title"
        },
        "description": {
          "type": "string",
          "description": "Optional event description"
        },
        "startDate": {
          "type": "string",
          "description": "Start date YYYY-MM-DD"
        },
        "endDate": {
          "type": "string",
          "description": "End date YYYY-MM-DD"
        },
        "startTime": {
          "type": "string",
          "description": "Optional start time HH:mm"
        },
        "endTime": {
          "type": "string",
          "description": "Optional end time HH:mm"
        },
        "allDay": {
          "type": "boolean",
          "description": "Whether the event lasts all day"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner persona (partner1, partner2, or both)"
        },
        "color": {
          "type": "string",
          "description": "Hex color code for event pill"
        },
        "category": {
          "type": "string",
          "description": "Event category"
        },
        "mood": {
          "type": "string",
          "description": "Optional mood emoji tag"
        },
        "supportMessages": {
          "type": "array",
          "description": "Romantic love notes and encouragement messages"
        },
        "photos": {
          "type": "array",
          "description": "Memory photo attachments"
        },
        "photoUrl": {
          "type": "string",
          "description": "Main photo url"
        },
        "photoCaption": {
          "type": "string",
          "description": "Main photo caption"
        },
        "location": {
          "type": "string",
          "description": "Optional location"
        },
        "reminder": {
          "type": "string",
          "description": "Reminder preference"
        },
        "isMemory": {
          "type": "boolean",
          "description": "Whether this is saved as a couple memory"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp created"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp updated"
        }
      },
      "required": ["id", "title", "startDate", "ownerId", "color"]
    },
    "WishlistPlan": {
      "title": "WishlistPlan",
      "description": "Romantic wishlist idea or date plan for the couple",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique plan ID"
        },
        "title": {
          "type": "string",
          "description": "Plan title"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes or details"
        },
        "suggestedBy": {
          "type": "string",
          "description": "Partner who proposed the idea"
        },
        "category": {
          "type": "string",
          "description": "Category (dinner, trip, movie, activity, relax)"
        },
        "estimatedCost": {
          "type": "string",
          "description": "Optional estimated cost"
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the plan was done"
        },
        "scheduledEventId": {
          "type": "string",
          "description": "Optional linked calendar event ID"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp"
        }
      },
      "required": ["id", "title", "suggestedBy", "completed"]
    }
  },
  "firestore": {
    "/couple/{configId}": {
      "schema": "CoupleConfig",
      "description": "Global shared couple settings, names, colors, theme and anniversary date"
    },
    "/events/{eventId}": {
      "schema": "CalendarEvent",
      "description": "Real-time synchronizing calendar events for Miguel & Giulia"
    },
    "/plans/{planId}": {
      "schema": "WishlistPlan",
      "description": "Real-time synchronizing wishlist plans and date ideas"
    }
  }
}
